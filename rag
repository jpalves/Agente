class ChatHandler(BaseHTTPRequestHandler):
    indice: Indice | list = []

    def log_message(self, formato, *args):
        print(f"[servidor] {self.address_string()} - {formato % args}")

    def _responder_json(self, codigo: int, corpo: dict) -> None:
        payload = json.dumps(corpo).encode("utf-8")
        self.send_response(codigo)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def do_GET(self):
        path = urlsplit(self.path).path
        if path in ("/", "/index.html"):
            corpo = PAGINA_CHAT.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(corpo)))
            self.end_headers()
            self.wfile.write(corpo)
        elif path == "/favicon.ico" and FAVICON.is_file():
            corpo = FAVICON.read_bytes()
            self.send_response(200)
            self.send_header("Content-Type", "image/x-icon")
            self.send_header("Cache-Control", "public, max-age=86400")
            self.send_header("Content-Length", str(len(corpo)))
            self.end_headers()
            self.wfile.write(corpo)
        elif path == "/api/chat":
            self.send_response(405)
            self.send_header("Allow", "POST")
            self.send_header("Content-Type", "application/json; charset=utf-8")
            corpo = json.dumps(
                {
                    "erro": "A API aceita apenas POST. Abre a página do chat em /."
                }
            ).encode("utf-8")
            self.send_header("Content-Length", str(len(corpo)))
            self.end_headers()
            self.wfile.write(corpo)
        else:
            self.send_error(
                404,
                f"Rota não encontrada: {path}. Abre a página do chat em /.",
            )

    def do_POST(self):
        path = urlsplit(self.path).path
        if path != "/api/chat":
            self.send_error(404, f"Rota não encontrada: {path}.")
            return

        tamanho = int(self.headers.get("Content-Length", 0))
        try:
            dados = json.loads(self.rfile.read(tamanho) or b"{}")
        except json.JSONDecodeError:
            self._responder_json(400, {"erro": "JSON inválido."})
            return

        pergunta = str(dados.get("pergunta", "")).strip()
        if not pergunta:
            self._responder_json(400, {"erro": "Falta o campo 'pergunta'."})
            return

        historico = normalizar_historico(dados.get("historico"))
        usar_historico = dados.get("usar_historico", True) is not False
        resposta, _raciocinio, fontes, ambiguidade = responder(
            pergunta, ChatHandler.indice, historico if usar_historico else []
        )
        self._responder_json(
            200,
            {"resposta": resposta, "fontes": fontes, "ambiguidade": ambiguidade},
        )


def iniciar_servidor_https(indice: Indice, host: str = SERVIDOR_HOST, porta: int = SERVIDOR_PORTA) -> None:
    """Sobe um pequeno servidor HTTPS (biblioteca padrão, sem
    dependências extra) que serve uma página de chat em '/' e responde
    perguntas em POST '/api/chat'."""
    garantir_certificado()
    ChatHandler.indice = indice

    contexto_ssl = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    contexto_ssl.load_cert_chain(certfile=str(CERTIFICADO_CRT), keyfile=str(CERTIFICADO_KEY))

    servidor = ThreadingHTTPServer((host, porta), ChatHandler)
    servidor.socket = contexto_ssl.wrap_socket(servidor.socket, server_side=True)

    print(f"Servidor HTTPS a correr em https://{host}:{porta}  (Ctrl+C para parar)")
    try:
        servidor.serve_forever()
    except KeyboardInterrupt:
        print("\nA encerrar servidor...")
    finally:
        servidor.server_close()


def main() -> None:
    global MOSTRAR_RACIOCINIO, _aviso_raciocinio_mostrado

    argumentos = argparse.ArgumentParser(description="Agente RAG (CLI ou servidor HTTPS)")
    argumentos.add_argument(
        "--servidor", action="store_true",
        help="Inicia um servidor HTTPS com página de chat, em vez do modo texto.",
    )
    argumentos.add_argument("--host", default=SERVIDOR_HOST, help="Endereço a escutar.")
    argumentos.add_argument("--porta", type=int, default=SERVIDOR_PORTA, help="Porta HTTPS.")
    args = argumentos.parse_args()

    print(f"Base de conhecimento: {DOCUMENTS_DIR}")
    print(f"A criar índice com o modelo de embeddings '{EMBEDDING_MODEL}'...")
    try:
        indice = criar_indice()
    except TempoEsgotadoError as erro:
        print(f"Não foi possível criar o índice: {erro}")
        indice = Indice([], np.zeros((0, 1), dtype=np.float32))
    print(f"{len(indice)} trechos indexados.")

    if args.servidor:
        iniciar_servidor_https(indice, host=args.host, porta=args.porta)
        return

    print("Comandos: /sair, /reindexar, /limpar, /historico, /raciocinio")
    historico: list[dict[str, str]] = []
    usar_historico = True
    while True:
        pergunta = input("Tu: ").strip()
        comando = pergunta.lower()
        if comando in {"/sair", "/exit", "/quit"}:
            break
        if comando == "/reindexar":
            try:
                indice = criar_indice()
                print(f"{len(indice)} trechos indexados.")
            except TempoEsgotadoError as erro:
                print(f"Não foi possível reindexar: {erro}")
            continue
        if comando == "/limpar":
            historico = []
            print("Conversa reiniciada.")
            continue
        if comando == "/historico":
            usar_historico = not usar_historico
            estado = "ativado" if usar_historico else "desativado"
            print(f"Uso do histórico {estado}.")
            continue
        if comando == "/raciocinio":
            MOSTRAR_RACIOCINIO = not MOSTRAR_RACIOCINIO
            estado = "ativado" if MOSTRAR_RACIOCINIO else "desativado"
            print(f"Raciocínio {estado}.")
            continue
        if not pergunta:
            continue

        resposta, raciocinio, fontes, ambiguidade = responder(
            pergunta, indice, historico if usar_historico else []
        )
        historico += [
            {"role": "user", "content": pergunta},
            {"role": "assistant", "content": resposta},
        ]
        historico = historico[-MAX_MENSAGENS_HISTORICO:]
        if _raciocinio_suportado is False and MOSTRAR_RACIOCINIO and not _aviso_raciocinio_mostrado:
            print(f"(O modelo '{MODEL}' não suporta raciocínio; a ignorar.)")
            _aviso_raciocinio_mostrado = True
        if raciocinio:
            print(f"[Raciocínio]\n{raciocinio}\n")
        print("Agente:", resposta)
        if fontes:
            print("Fontes:", ", ".join(fontes))
        if ambiguidade:
            print(
                "Dispersão da pesquisa:",
                ambiguidade["nivel"],
                f"({ambiguidade['fontes']} fontes; equivalente a "
                f"cerca de {ambiguidade['fontes_efetivas']} fontes com peso semelhante).",
            )


if __name__ == "__main__":
    main()
