def palavras_conteudo(texto: str) -> set[str]:
    return palavras(texto) - PALAVRAS_COMUNS


class Indice:
    """Índice em memória preparado para pesquisa rápida.

    - `matriz`: embeddings normalizados (N x D), para calcular o cosseno
      de todos os trechos com um único produto matriz-vetor;
    - `invertido`: palavra -> ids dos trechos que a contêm, para calcular
      o Jaccard sem voltar a tokenizar os trechos a cada pergunta."""

    def __init__(self, trechos: list[Trecho], matriz: np.ndarray):
        self.trechos = trechos
        normas = np.linalg.norm(matriz, axis=1, keepdims=True)
        self.matriz = matriz / np.where(normas == 0, 1, normas)
        self.fatores_tipo = np.array(
            [
                FATOR_PESO_PDF
                if Path(trecho.fonte).suffix.lower() in EXTENSOES_PDF
                else FATOR_PESO_TEXTO
                if Path(trecho.fonte).suffix.lower() in EXTENSOES_TEXTO
                else 1.0
                for trecho in trechos
            ],
            dtype=np.float32,
        )
        self.n_palavras = np.zeros(len(trechos), dtype=np.int32)
        listas: dict[str, list[int]] = {}
        for numero, trecho in enumerate(trechos):
            conjunto = palavras_conteudo(trecho.texto)
            self.n_palavras[numero] = len(conjunto)
            for palavra in conjunto:
                listas.setdefault(palavra, []).append(numero)
        # palavras presentes em muitos trechos ("de", "que", "para"...) não
        # distinguem nada e fazem o Jaccard favorecer trechos longos ao acaso
        limite = max(50, int(FREQUENCIA_MAXIMA_PALAVRA * len(trechos)))
        for palavra, ids in listas.items():
            if len(ids) > limite:
                self.n_palavras[ids] -= 1
        self.invertido = {
            palavra: np.array(ids, dtype=np.int32)
            for palavra, ids in listas.items()
            if len(ids) <= limite
        }

    def __len__(self) -> int:
        return len(self.trechos)

    def ids_com_correspondencia_lexica(self, pergunta: str) -> np.ndarray:
        ids = [
            self.invertido[p]
            for p in palavras_conteudo(pergunta)
            if p in self.invertido
        ]
        return np.unique(np.concatenate(ids)) if ids else np.array([], dtype=np.int32)

    def similaridades_embeddings(self, vetor_pergunta: list[float]) -> np.ndarray:
        vetor = np.asarray(vetor_pergunta, dtype=np.float32)
        norma = np.linalg.norm(vetor)
        return self.matriz @ (vetor / norma if norma else vetor)

    def pontuacoes(self, pergunta: str, vetor_pergunta: list[float]) -> np.ndarray:
        """Pontuação híbrida (cosseno + Jaccard) de todos os trechos."""
        cosseno = self.similaridades_embeddings(vetor_pergunta)

        # Cobertura ponderada por IDF: fração da "informação" das palavras da
        # pergunta presente no trecho. Palavras raras ("quicksort") pesam
        # muito; palavras comuns ("que", "é") quase nada. É mais robusta que
        # o Jaccard puro, que dilui a pontuação em trechos longos.
        cobertura = np.zeros(len(self.trechos), dtype=np.float32)
        total = 0.0
        for palavra in palavras_conteudo(pergunta):
            ids = self.invertido.get(palavra)
            if ids is None:
                continue
            peso = math.log(len(self.trechos) / len(ids))
            cobertura[ids] += peso
            total += peso
        jaccard = cobertura / total if total else cobertura

        return (PESO_EMBEDDINGS * cosseno + PESO_JACCARD * jaccard) * self.fatores_tipo


def dividir_em_trechos(texto: str) -> list[str]:
    """Divide um documento em parágrafos/frases, agrupando-os até ao
    tamanho alvo. Evita cortar a meio de palavras/frases, o que gerava
    trechos sem sentido e muito repetidos entre si."""
    paragrafos = [p.strip() for p in re.split(r"\n\s*\n", texto) if p.strip()]
    unidades: list[str] = []
    for paragrafo in paragrafos:
        frases = re.split(r"(?<=[.!?])\s+", " ".join(paragrafo.split()))
        for frase in frases:
            if not frase:
                continue
            # salvaguarda: texto sem pontuação (ex.: código-fonte ou PDFs
            # mal extraídos) pode gerar uma "frase" gigantesca que nunca
            # é cortada abaixo; corta-a à força em blocos de CHUNK_SIZE
            # para não enviar trechos enormes ao modelo de embeddings.
            if len(frase) > CHUNK_SIZE * 2:
                for inicio in range(0, len(frase), CHUNK_SIZE):
                    unidades.append(frase[inicio : inicio + CHUNK_SIZE])
            else:
                unidades.append(frase)

    if not unidades:
        return []

    trechos = []
    atual = ""
    for unidade in unidades:
        candidato = f"{atual} {unidade}".strip() if atual else unidade
        if len(candidato) > CHUNK_SIZE and atual:
            trechos.append(atual)
            # pequena sobreposição: repete o fim do trecho anterior
            atual = f"{atual[-CHUNK_OVERLAP:]} {unidade}".strip()
        else:
            atual = candidato
    if atual:
        trechos.append(atual)

    # remove trechos duplicados ou quase idênticos entre si
    vistos: set[str] = set()
    trechos_unicos = []
    for trecho in trechos:
        chave = trecho[:200]
        if chave in vistos:
            continue
        vistos.add(chave)
        trechos_unicos.append(trecho)
    return trechos_unicos


def remover_surrogates_invalidos(texto: str) -> str:
    """Remove caracteres substitutos (surrogates) isolados.

    Alguns PDFs (sobretudo com símbolos matemáticos/fontes customizadas)
    têm cmaps mal formados; o pypdf acaba por extrair metade de um par
    surrogate (ex.: '\\ud835' sem o seu par), o que é válido em `str` mas
    não pode ser codificado em UTF-8 — e isso rebentava o pedido JSON ao
    Ollama. Como não há forma fiável de recuperar o caracter original,
    descartamo-lo."""
    return texto.encode("utf-8", errors="ignore").decode("utf-8")


def ler_pdf(caminho: Path) -> str:
    """Extrai o texto de um PDF, página a página."""
    leitor = PdfReader(str(caminho))
    paginas = []
    for pagina in leitor.pages:
        texto_pagina = pagina.extract_text() or ""
        if texto_pagina.strip():
            paginas.append(texto_pagina)
    return remover_surrogates_invalidos("\n\n".join(paginas))


def ler_documento(caminho: Path) -> str:
    """Lê o conteúdo de um documento, tratando PDFs de forma diferente
    de ficheiros de texto simples."""
    if caminho.suffix.lower() in EXTENSOES_PDF:
        return ler_pdf(caminho)
    return remover_surrogates_invalidos(caminho.read_text(encoding="utf-8"))


def _abrir_cache() -> sqlite3.Connection:
    ligacao = sqlite3.connect(CACHE_DB)
    ligacao.executescript(
        """
        CREATE TABLE IF NOT EXISTS meta (chave TEXT PRIMARY KEY, valor TEXT);
        CREATE TABLE IF NOT EXISTS ficheiros (
            caminho TEXT PRIMARY KEY, mtime_ns INTEGER, tamanho INTEGER
        );
        CREATE TABLE IF NOT EXISTS trechos (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            caminho TEXT NOT NULL REFERENCES ficheiros(caminho) ON DELETE CASCADE,
            texto TEXT NOT NULL,
            vetor BLOB NOT NULL
        );
        CREATE INDEX IF NOT EXISTS idx_trechos_caminho ON trechos(caminho);
        """
    )
    ligacao.execute("PRAGMA foreign_keys = ON")
    # Se o modelo ou o tamanho dos trechos mudou, os vetores guardados
    # deixam de ser válidos e a cache é descartada.
    assinatura = f"{EMBEDDING_MODEL}|{CHUNK_SIZE}|{CHUNK_OVERLAP}"
    guardada = ligacao.execute(
        "SELECT valor FROM meta WHERE chave = 'assinatura'"
    ).fetchone()
    if guardada is None or guardada[0] != assinatura:
        ligacao.execute("DELETE FROM trechos")
        ligacao.execute("DELETE FROM ficheiros")
        ligacao.execute(
            "INSERT OR REPLACE INTO meta VALUES ('assinatura', ?)", (assinatura,)
        )
        ligacao.commit()
    return ligacao


def _gerar_embeddings(textos: list[str]) -> list[list[float]] | None:
    """Calcula embeddings em lotes pequenos (um pedido gigante pode
    derrubar o servidor). Devolve None se algum lote falhar."""
    vetores: list[list[float]] = []
    for inicio in range(0, len(textos), TAMANHO_LOTE_EMBED):
        lote = textos[inicio : inicio + TAMANHO_LOTE_EMBED]
        try:
            resposta = executar_com_limite(
                cliente.embed, model=EMBEDDING_MODEL, input=lote
            )
        except (TempoEsgotadoError, ollama.ResponseError) as erro:
            print(f"Aviso: falhou um lote de embeddings ({len(lote)} trechos): {erro}")
            return None
        vetores.extend(resposta["embeddings"])
    return vetores


def criar_indice() -> Indice:
    """Devolve o índice da pasta de documentos, usando uma cache SQLite.

    Só os ficheiros novos ou modificados (mtime/tamanho) são relidos e
    voltam a passar pelo modelo de embeddings; os restantes são lidos
    diretamente da base de dados."""
    if not DOCUMENTS_DIR.exists():
        DOCUMENTS_DIR.mkdir()
        return Indice([], np.zeros((0, 1), dtype=np.float32))

    extensoes_suportadas = EXTENSOES_TEXTO | EXTENSOES_PDF
    ficheiros = {
        str(f.relative_to(DOCUMENTS_DIR)): f
        for f in DOCUMENTS_DIR.rglob("*")
        if f.is_file() and f.suffix.lower() in extensoes_suportadas
    }

    ligacao = _abrir_cache()
    try:
        em_cache = {
            caminho: (mtime, tamanho)
            for caminho, mtime, tamanho in ligacao.execute(
                "SELECT caminho, mtime_ns, tamanho FROM ficheiros"
            )
        }
        for caminho in set(em_cache) - set(ficheiros):
            ligacao.execute("DELETE FROM ficheiros WHERE caminho = ?", (caminho,))
        ligacao.commit()

        trechos: list[Trecho] = []
        blocos: list[np.ndarray] = []
        novos = 0
        for caminho, ficheiro in sorted(ficheiros.items()):
            estado = ficheiro.stat()
            assinatura = (estado.st_mtime_ns, estado.st_size)
            if em_cache.get(caminho) == assinatura:
                linhas = ligacao.execute(
                    "SELECT texto, vetor FROM trechos WHERE caminho = ? ORDER BY id",
                    (caminho,),
                ).fetchall()
                if linhas:
                    trechos.extend(Trecho(texto, caminho) for texto, _ in linhas)
                    blocos.append(
                        np.frombuffer(b"".join(b for _, b in linhas), dtype=np.float32)
                        .reshape(len(linhas), -1)
                    )
                continue

            try:
                conteudo = ler_documento(ficheiro)
            except Exception as erro:
                print(f"Aviso: não foi possível ler '{ficheiro.name}': {erro}")
                continue
            textos = dividir_em_trechos(conteudo)
            vetores = _gerar_embeddings(textos) if textos else []
            if vetores is None:
                continue  # não fica em cache: será tentado de novo no próximo arranque

            print(f"  indexado: {caminho} ({len(textos)} trechos)")
            ligacao.execute("DELETE FROM ficheiros WHERE caminho = ?", (caminho,))
            ligacao.execute(
                "INSERT INTO ficheiros VALUES (?, ?, ?)", (caminho, *assinatura)
            )
            ligacao.executemany(
                "INSERT INTO trechos (caminho, texto, vetor) VALUES (?, ?, ?)",
                [
                    (caminho, texto, array("f", vetor).tobytes())
                    for texto, vetor in zip(textos, vetores)
                ],
            )
            ligacao.commit()  # progresso guardado ficheiro a ficheiro
            if textos:
                trechos.extend(Trecho(texto, caminho) for texto in textos)
                blocos.append(np.asarray(vetores, dtype=np.float32))
            novos += 1
        if novos:
            print(f"{novos} ficheiro(s) novos/alterados indexados.")
        if not trechos:
            return Indice([], np.zeros((0, 1), dtype=np.float32))
        return Indice(trechos, np.vstack(blocos))
    finally:
        ligacao.close()


_TRADUCOES: dict[str, str] = {}


def traduzir_consulta(pergunta: str) -> str:
    """Traduz a pergunta para inglês (a maioria das fontes está em inglês)."""
    if pergunta in _TRADUCOES:
        return _TRADUCOES[pergunta]
    traducao = ""
    try:
        resposta = executar_com_limite(
            cliente.chat,
            model=MODEL,
            messages=[
                {
                    "role": "user",
                    "content": "Translate to English, keeping technical terms. "
                    "Reply with the translation only:\n" + pergunta,
                }
            ],
            options={"temperature": 0, "num_predict": 80},
            keep_alive=KEEP_ALIVE,
        )
        traducao = resposta["message"]["content"].strip().splitlines()[0]
    except Exception:
        pass
    if len(_TRADUCOES) > 200:
        _TRADUCOES.clear()
    _TRADUCOES[pergunta] = traducao
    return traducao


def recuperar(pergunta: str, indice: Indice) -> list[Trecho]:
    if not len(indice):
        return []
    consultas = [pergunta]
    traducao = traduzir_consulta(pergunta)
    if traducao and traducao.lower() != pergunta.lower():
        consultas.append(traducao)
    pontuacao = np.zeros(len(indice), dtype=np.float32)
    similaridades = np.zeros(len(indice), dtype=np.float32)
    tem_lexico = np.zeros(len(indice), dtype=bool)
    # Cada consulta (original e traduzida) é avaliada; fica o melhor resultado
    for consulta in consultas:
        vetor = executar_com_limite(
            cliente.embed,
            model=EMBEDDING_MODEL,
            input=consulta,
            keep_alive=KEEP_ALIVE,
        )["embeddings"][0]
        pontuacao = np.maximum(pontuacao, indice.pontuacoes(consulta, vetor))
        similaridades = np.maximum(
            similaridades, indice.similaridades_embeddings(vetor)
        )
        tem_lexico[indice.ids_com_correspondencia_lexica(consulta)] = True
    # Um trecho é candidato se a pontuação híbrida chega ao limiar E há
    # correspondência de palavras, ou se é semanticamente muito próximo
    # mesmo sem a palavra exata (sinónimos, outro idioma, outras fontes).
    candidatos = np.flatnonzero(
        ((pontuacao >= SIMILARIDADE_MINIMA) & tem_lexico)
        | (similaridades >= SIMILARIDADE_EMBEDDINGS_MINIMA)
    )
    if candidatos.size:
        # descarta o que ficou muito abaixo do melhor resultado
        candidatos = candidatos[
            pontuacao[candidatos] >= 0.8 * pontuacao[candidatos].max()
        ]
    ordenados = candidatos[np.argsort(-pontuacao[candidatos], kind="stable")]

    # Seleção por rondas: primeiro o melhor trecho de cada fonte (por ordem
    # de relevância), depois o segundo melhor de cada uma, etc. Garante
    # que todas as fontes relevantes são representadas em vez de uma única
    # fonte ocupar o contexto.
    por_fonte: dict[str, list[int]] = {}
    for numero in ordenados:
        lista = por_fonte.setdefault(indice.trechos[numero].fonte, [])
        if len(lista) < MAX_TRECHOS_POR_FONTE:
            lista.append(int(numero))
    resultados: list[Trecho] = []
    ronda = 0
    while len(resultados) < TOP_K and any(len(v) > ronda for v in por_fonte.values()):
        da_ronda = sorted(
            (v[ronda] for v in por_fonte.values() if len(v) > ronda),
            key=lambda n: -pontuacao[n],
        )
        resultados.extend(
            Trecho(
                indice.trechos[n].texto,
                indice.trechos[n].fonte,
                float(pontuacao[n]),
            )
            for n in da_ronda[: TOP_K - len(resultados)]
        )
        ronda += 1
    return resultados


def estimar_ambiguidade(contexto: list[Trecho]) -> dict[str, str | float | int] | None:
    """Estima dispersão entre fontes; não mede confiança factual nem sentidos."""
    melhores_por_fonte: dict[str, float] = {}
    for trecho in contexto:
        melhores_por_fonte[trecho.fonte] = max(
            melhores_por_fonte.get(trecho.fonte, float("-inf")),
            trecho.pontuacao,
        )
    pontuacoes = np.asarray(list(melhores_por_fonte.values()), dtype=np.float64)
    if pontuacoes.size < 2:
        return None

    pesos = np.exp((pontuacoes - pontuacoes.max()) / 0.05)
    pesos /= pesos.sum()
    entropia = -float(np.sum(pesos * np.log(pesos)))
    fontes_efetivas = math.exp(entropia)
    if fontes_efetivas <= 1.5:
        nivel = "baixo"
    elif fontes_efetivas <= 3:
        nivel = "moderado"
    else:
        nivel = "alto"
    return {
        "nivel": nivel,
        "fontes": int(pontuacoes.size),
        "fontes_efetivas": round(fontes_efetivas, 1),
    }


def decidir_estrategia_resposta(
    contexto: list[Trecho],
    dispersao: dict[str, str | float | int] | None,
    usar_historico: bool,
) -> str:
    modos_validos = {"automatico", "priorizar_documentos", "priorizar_llm"}
    if MODO_RESPOSTA not in modos_validos:
        raise ValueError(
            f"MODO_RESPOSTA inválido: {MODO_RESPOSTA!r}. "
            f"Valores válidos: {', '.join(sorted(modos_validos))}."
        )
    if usar_historico:
        return "historico"
    if not contexto:
        return "llm-geral"
    if MODO_RESPOSTA == "priorizar_documentos":
        return "documentos"
    if MODO_RESPOSTA == "priorizar_llm":
        return "llm-principal"
    if dispersao and dispersao["nivel"] in {"moderado", "alto"}:
        return "sintese-multifonte"
    return "fonte-principal"


