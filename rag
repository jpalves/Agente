)


def limpar_raciocinio_do_texto(texto: str) -> str:
    """Remove blocos de 'pensamento em voz alta' que alguns modelos
    inserem no próprio `content`, em vez de os enviar em `thinking`.
    Deteta o padrão típico "1. **Passo**: ..." seguido da resposta
    final e mantém apenas essa última parte."""
    marcadores_finais = [
        "Final Output Generation",
        "Resposta final",
        "Output Generation",
    ]
    for marcador in marcadores_finais:
        indice_marcador = texto.rfind(marcador)
        if indice_marcador != -1:
            resto = texto[indice_marcador + len(marcador):]
            resto = resto.lstrip(":*.\n ")
            if resto.strip():
                return resto.strip()

    # Se o texto começa por uma lista numerada em negrito ("1. **...**"),
    # assume-se que é raciocínio; tenta encontrar a última linha "solta"
    # não numerada e usa-a como resposta.
    linhas = texto.splitlines()
    if linhas and re.match(r"^\s*\d+\.\s*\*\*", linhas[0]):
        for linha in reversed(linhas):
            linha_limpa = linha.strip().strip("*")
            if linha_limpa and not re.match(r"^\d+\.", linha_limpa):
                return linha_limpa
    return texto


def normalizar_historico(historico) -> list[dict[str, str]]:
    """Mantém só mensagens válidas (user/assistant com texto) e as mais
    recentes. O histórico guarda apenas as perguntas e respostas
    originais, sem o contexto recuperado, para não encher o prompt."""
    if not isinstance(historico, list):
        return []
    validas = [
        {"role": m["role"], "content": m["content"]}
        for m in historico
        if isinstance(m, dict)
        and m.get("role") in {"user", "assistant"}
        and isinstance(m.get("content"), str)
        and m["content"].strip()
    ]
    return validas[-MAX_MENSAGENS_HISTORICO:]


def refere_se_a_resposta_anterior(pergunta: str) -> bool:
    return bool(
        re.fullmatch(
            r"\s*(?:repete|resume|continua|desenvolve|"
            r"explica melhor|podes repetir|podes explicar melhor)\s*[.!?]*\s*",
            pergunta.casefold(),
        )
        or re.search(
            r"\b(repete (?:a )?(?:resposta|o que disseste)|"
            r"resume (?:a )?(?:resposta|conversa|o que disseste)|"
            r"o que disseste|qual foi a resposta|"
            r"na resposta anterior|na pergunta anterior|"
            r"explica melhor (?:isso|a resposta|o que disseste)|"
            r"podes repetir (?:isso|a resposta)|"
            r"podes explicar melhor (?:isso|a resposta))\b",
            pergunta.casefold(),
        )
    )


def responder(
    pergunta: str,
    indice: Indice,
    historico: list[dict[str, str]] | None = None,
) -> tuple[str, str | None, list[str], dict[str, str | float | int] | None]:
    """Devolve resposta, raciocínio, fontes e estimativa de dispersão.

    O raciocínio pode ser None se não estiver disponível. A dispersão é
    None se houver menos de duas fontes distintas.

    `historico` são as mensagens anteriores da conversa (user/assistant)."""
    global _raciocinio_suportado

    historico = normalizar_historico(historico)
    try:
        # Preserva o tópico nas perguntas de seguimento sem juntar toda a
        # conversa à pesquisa e diluir a relevância dos resultados.
        anteriores = [m["content"] for m in historico if m["role"] == "user"]
        usar_historico = bool(anteriores) and refere_se_a_resposta_anterior(pergunta)
        consulta = " ".join([*anteriores[-2:], pergunta])
        contexto = [] if usar_historico else recuperar(consulta, indice)
        ambiguidade = estimar_ambiguidade(contexto)
        estrategia = decidir_estrategia_resposta(
            contexto, ambiguidade, usar_historico
        )
        if contexto:
            fontes_por_nome = list(dict.fromkeys(t.fonte for t in contexto))
            numeros_fontes = {nome: i + 1 for i, nome in enumerate(fontes_por_nome)}
            fontes = "\n\n".join(
                f"[Fonte {numeros_fontes[trecho.fonte]}: {trecho.fonte}]\n"
                f"{trecho.texto}"
                for trecho in contexto
            )
            instrucao = (
                "Usa primeiro o histórico para resolver referências como "
                "\"isso\" ou \"o segundo\". Para responder à pergunta atual "
                "sobre documentos, usa apenas os excertos identificados por "
                "[Fonte N]; cada afirmação sobre os documentos deve ter uma "
                "citação [Fonte N] correspondente. Não inventes citações nem "
                "atribuições. Se os excertos não responderem, diz claramente "
                "que não encontraste essa informação. Se as fontes "
                "discordarem, explica a diferença. Se abordarem sentidos "
                "diferentes de um termo, identifica-os em vez de os misturar."
            )
            if estrategia == "fonte-principal":
                instrucao += (
                    " A pontuação está concentrada numa fonte principal: "
                    "prioriza essa fonte e usa as restantes apenas para "
                    "corroborar ou acrescentar informação claramente relevante."
                )
            elif estrategia == "sintese-multifonte":
                instrucao += (
                    " A relevância está distribuída por várias fontes: "
                    "sintetiza os excertos relevantes, atribui cada afirmação "
                    "à respetiva fonte e separa perspetivas distintas. "
                    "Dispersão não significa, por si só, contradição."
                )
            elif estrategia == "documentos":
                instrucao += (
                    " MODO priorizar_documentos: baseia a resposta apenas nos "
                    "excertos recuperados; não acrescentes conhecimento geral "
                    "do modelo como se viesse do corpus."
                )
            elif estrategia == "llm-principal":
                instrucao += (
                    " MODO priorizar_llm: responde primeiro com o conhecimento "
                    "geral do modelo. Usa os excertos como apoio secundário, "
                    "separa claramente o que vem deles do que é conhecimento "
                    "geral e cita apenas afirmações efetivamente apoiadas nas fontes."
                )
            pergunta_modelo = (
                f"EXCERTOS RECUPERADOS:\n{fontes}\n\n"
                f"PERGUNTA ATUAL: {pergunta}"
            )
        else:
            instrucao = (
                "Responde apenas com base no histórico da conversa; não "
                "consultes nem inventes fontes documentais."
                if usar_historico
                else
                (
                    "A pesquisa não encontrou excertos relevantes nos documentos. "
                    "Não inventes informação documental. Diz que não encontraste "
                    "apoio no corpus."
                    if MODO_RESPOSTA == "priorizar_documentos"
                    else
                    "A pesquisa não encontrou excertos relevantes nos documentos. "
                    "Responde à pergunta com conhecimento geral do modelo, se "
                    "souberes, e começa por indicar brevemente que a resposta não "
                    "foi encontrada no corpus. Não afirmes que consultaste fontes "
                    "nem apresentes conhecimento geral como se viesse dos documentos."
                )
            )
            pergunta_modelo = pergunta

        pedir_raciocinio = MOSTRAR_RACIOCINIO and _raciocinio_suportado is not False
        mensagens = [
            {"role": "system", "content": f"{INSTRUCAO_SISTEMA}\n\n{instrucao}"},
            *historico,
            {"role": "user", "content": pergunta_modelo},
        ]
        try:
            response = executar_com_limite(
                cliente.chat,
                model=MODEL,
                messages=mensagens,
                think=pedir_raciocinio,
                options={"num_ctx": NUM_CTX, "temperature": 0.2},
                keep_alive=KEEP_ALIVE,
            )
        except ollama.ResponseError as erro:
            if pedir_raciocinio and erro.status_code == 400:
                # o modelo não suporta "think"; desativa e tenta de novo
                _raciocinio_suportado = False
                response = executar_com_limite(
                    cliente.chat,
                    model=MODEL,
                    messages=mensagens,
                    options={"num_ctx": NUM_CTX, "temperature": 0.2},
                    keep_alive=KEEP_ALIVE,
                )
            else:
                raise

        if pedir_raciocinio:
            _raciocinio_suportado = True
        raciocinio = response["message"].get("thinking") if pedir_raciocinio else None
        conteudo = limpar_raciocinio_do_texto(response["message"]["content"])
        return (
            conteudo,
            raciocinio,
            list(dict.fromkeys(t.fonte for t in contexto)),
            ambiguidade,
        )
    except TempoEsgotadoError as erro:
        return f"Tempo esgotado: {erro} Tenta novamente.", None, [], None



def garantir_certificado() -> None:
    """Gera um certificado autoassinado (via openssl) se ainda não existir.
    Suficiente para desenvolvimento/uso na rede local; navegadores vão
    mostrar um aviso de "certificado não confiável" por não ser emitido
    por uma autoridade reconhecida."""
    enderecos = {ipaddress.ip_address("127.0.0.1")}
    saida = subprocess.run(
        ["hostname", "-I"], check=True, capture_output=True, text=True
    ).stdout
    for valor in saida.split():
        try:
            enderecos.add(ipaddress.ip_address(valor))
        except ValueError:
            continue

    extensoes_san = {"DNS:localhost"}
    extensoes_san.update(
        f"IP:{endereco}" for endereco in sorted(enderecos, key=str)
    )
    extensao_san = "subjectAltName=" + ",".join(sorted(extensoes_san))

    if CERTIFICADO_CRT.exists() and CERTIFICADO_KEY.exists():
        certificado = subprocess.run(
            ["openssl", "x509", "-in", str(CERTIFICADO_CRT), "-noout", "-ext", "subjectAltName"],
            capture_output=True,
            text=True,
            check=False,
        ).stdout
        nomes_exibidos = {
            nome.replace("IP:", "IP Address:")
            for nome in extensoes_san
        }
        if all(nome in certificado for nome in nomes_exibidos):
            return

    CERTIFICADO_DIR.mkdir(exist_ok=True)
    subprocess.run(
        [
            "openssl", "req", "-x509", "-newkey", "rsa:2048",
            "-keyout", str(CERTIFICADO_KEY),
            "-out", str(CERTIFICADO_CRT),
            "-days", "365", "-nodes",
            "-subj", "/CN=localhost",
            "-addext", extensao_san,
        ],
        check=True,
        capture_output=True,
    )


